#!/usr/bin/env node
// bbe-gate — the brand gate a consumer repo runs, from the package, not from a
// vendored copy of it.
//
//   npx bbe-gate                    scan the current repo, ratchet against the baseline
//   npx bbe-gate --repo <dir>       scan somewhere other than the cwd
//   npx bbe-gate --write-baseline   lower bbe.config.json's baseline to today's count
//   npx bbe-gate --json             machine-readable result on stdout
//   npx bbe-gate --selftest         plant a defect in a fixture, assert the scanner goes RED
//
// Exit 0 clean or improved. Exit 1 the BRAND count rose above the baseline.
// Exit 2 the gate could not run (no config, no pack mirror, bad input, a named
// buildDir that was never built, or a head check that read zero pages).
//
// WHY THIS EXISTS. Before the package, every repo carried its own byte-copy of
// brand-drift.mjs plus its own brand-gate-check.mjs plus a gate-parity.mjs whose
// only job was to prove the copy had not drifted. Three files and a whole class
// of drift, to run one check. On 2026-09-08 those copies were measured: three
// different revisions of brand-drift.mjs were live across the estate at once.
// This is that check, installed instead of copied, so the parity file has nothing
// left to guard.
//
// ONE CONFIG FILE. `bbe.config.json` at the repo root:
//
//   {
//     "pack": "gabriella",        // -> brand/gabriella.brandpack.json
//     "exclude": ["data"],        // ADDITIVE to the defaults below
//     "baseline": 4               // the ratchet
//   }
//
// The baseline used to live in a second file (tools/brand-gate-baseline.json) that
// nothing else read. Two files to configure one check is one file too many, so the
// baseline folded in. The old file is still honoured when bbe.config.json is absent,
// so a repo that has not migrated yet keeps gating.
//
// THE EXCLUDE CONTRACT is the one estate.json already uses: whatever a repo lists is
// ADDED to the defaults, never replaces them. Defaults are brand-drift's own
// (node_modules, .git, dist, dot-paths, *.brandpack.json, files whose header says they
// were GENERATED from a pack) plus `tools`, because the tools directory holds gate
// fixtures and token plumbing that quote colours as test data, not as page paint. A
// repo's `exclude` here should be the same list its estate.json row carries, so the
// CI number and the nightly number are the same number.
//
// THE RATCHET is deliberately unchanged from the copies this replaces: the job fails
// only when the BRAND count RISES above the baseline. `--write-baseline` lowers it and
// refuses to raise it. A gate that goes red on routine work gets switched off, and
// then it protects nothing.

import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import { scanRepo, DEFAULT_EXCLUDE } from '../tools/brand-drift.mjs';
import { scanKit, normalizeBuildDir } from '../tools/kit-drift.mjs';
import { scanHead } from '../tools/head-check.mjs';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const DRIFT = path.join(HERE, '..', 'tools', 'brand-drift.mjs');
const PKG = JSON.parse(readFileSync(path.join(HERE, '..', 'package.json'), 'utf8'));

// Excluded on top of brand-drift's defaults, for every repo on this gate.
const EXTRA_EXCLUDE = ['tools'];

const CONFIG_NAME = 'bbe.config.json';
const LEGACY_BASELINE = path.join('tools', 'brand-gate-baseline.json');

function argOf(flag) {
  const i = process.argv.indexOf(flag);
  return i > -1 && process.argv[i + 1] && !process.argv[i + 1].startsWith('--') ? process.argv[i + 1] : null;
}
const has = (flag) => process.argv.includes(flag);
const JSON_OUT = has('--json');
const say = (...a) => { if (!JSON_OUT) console.log(...a); };

if (has('--help') || has('-h')) {
  console.log(`bbe-gate (@andrew22lane/bbe ${PKG.version})

usage: bbe-gate [--repo <dir>] [--write-baseline] [--json] [--selftest]

Reads bbe.config.json at the repo root:
  { "pack": "<slug>", "exclude": ["<dir>", ...], "baseline": <number> }

  --repo <dir>       scan somewhere other than the cwd
  --write-baseline   lower "baseline" to the count just measured (never raises it)
  --json             print the result as JSON, nothing else
  --selftest         run brand-drift's own planted-defect selftest`);
  process.exit(0);
}

// The selftest is brand-drift's own: it plants a known hex in a fixture repo and
// asserts the scanner reports it. Delegated rather than reimplemented.
if (has('--selftest')) {
  const r = spawnSync(process.execPath, [DRIFT, '--selftest'], { stdio: 'inherit' });
  process.exit(r.status === null ? 2 : r.status);
}

function die(msg, extra = []) {
  if (JSON_OUT) console.log(JSON.stringify({ ok: false, error: msg }, null, 2));
  else {
    console.error(`FAIL: ${msg}`);
    for (const l of extra) console.error(l);
  }
  process.exit(2);
}

const repoRoot = path.resolve(argOf('--repo') || process.cwd());
const configPath = path.join(repoRoot, CONFIG_NAME);
const legacyPath = path.join(repoRoot, LEGACY_BASELINE);

// ---------------------------------------------------------------- the config
let config = null;
let configSource = null;

if (existsSync(configPath)) {
  try { config = JSON.parse(readFileSync(configPath, 'utf8')); }
  catch (e) { die(`${CONFIG_NAME} is not valid JSON: ${e.message}`); }
  configSource = configPath;
} else if (existsSync(legacyPath)) {
  // Pre-v1.2.0 repos. Same two fields under their old names, no exclude list.
  let legacy;
  try { legacy = JSON.parse(readFileSync(legacyPath, 'utf8')); }
  catch (e) { die(`${LEGACY_BASELINE} is not valid JSON: ${e.message}`); }
  config = { pack: legacy.pack, baseline: legacy.brand_count, exclude: [] };
  configSource = legacyPath;
  say(`note: reading the legacy ${LEGACY_BASELINE}. Migrate to ${CONFIG_NAME} — see docs/MIGRATE-GATE.md in andrew22lane/bbe.`);
} else {
  die(`no ${CONFIG_NAME} at ${repoRoot}`, [
    'A repo on the gate carries bbe.config.json at its root:',
    '  { "pack": "<slug>", "exclude": [], "baseline": <number> }',
    'Recipe: docs/MIGRATE-GATE.md in andrew22lane/bbe.'
  ]);
}

if (!config.pack || typeof config.pack !== 'string') {
  die(`${configSource} needs a "pack" slug (the basename of brand/<slug>.brandpack.json)`);
}
if (typeof config.baseline !== 'number' || !Number.isFinite(config.baseline) || config.baseline < 0) {
  die(`${configSource} needs a numeric "baseline" >= 0`);
}
if (config.exclude != null && (!Array.isArray(config.exclude) || config.exclude.some((e) => typeof e !== 'string'))) {
  die(`${configSource} "exclude" must be an array of strings, additive to the defaults`);
}
if (config.kit != null) {
  if (typeof config.kit !== 'object' || Array.isArray(config.kit)) {
    die(`${configSource} "kit" must be an object: { "url": "...", "local": "...", "reserved": [...] }`);
  }
  if (!config.kit.url && !config.kit.local) {
    die(`${configSource} "kit" needs a "url" or a "local" path — see ONE-SYSTEM-LAW.md`);
  }
  // Andrew, 2026-09-15: "same favicon should be used for all pages created, and
  // a default branded share image must be auto set up for all pages made."
  // Both optional, both opt-in, both independent — a brand can wire in one
  // before the other. Absent, the head check is skipped, not failed.
  if (config.kit.favicon != null && typeof config.kit.favicon !== 'string') {
    die(`${configSource} "kit.favicon" must be a string (an absolute URL)`);
  }
  if (config.kit.ogImage != null && typeof config.kit.ogImage !== 'string') {
    die(`${configSource} "kit.ogImage" must be a string (an absolute URL)`);
  }
}

// "buildDir": where the build writes pages. An engine site (build.mjs calling
// engine/lib.mjs head()) has no page in its source at all, so without this the kit
// link check and the head check read zero pages and pass. Found 2026-09-15 on a fresh
// `bbe new-surface --kind site`: "head check ... (0 files checked)", then PASS.
let buildDir = null;
if (config.buildDir != null) {
  const raw = typeof config.buildDir === 'string' ? normalizeBuildDir(config.buildDir) : '';
  const inside = raw && raw !== '.' && !path.isAbsolute(raw)
    && path.resolve(repoRoot, raw).startsWith(repoRoot + path.sep);
  if (!inside) {
    die(`${configSource} "buildDir" must be a directory inside the repo, relative to ${CONFIG_NAME}, e.g. "dist"`);
  }
  buildDir = raw;
}

const packPath = path.join(repoRoot, 'brand', `${config.pack}.brandpack.json`);
if (!existsSync(packPath)) {
  die(`pack mirror missing at ${packPath}`, [
    'The pack is a MIRROR of the canonical pack in the dh-hub vault. Copy it in.'
  ]);
}

// A named buildDir that is not there means the build has not run. Scanning an empty
// directory would be the same blind pass this key exists to end, so stop instead.
if (buildDir && config.kit && !existsSync(path.join(repoRoot, buildDir))) {
  die(`buildDir ${buildDir}/ does not exist, so there are no built pages to check.`, [
    'The kit and head checks read the pages your build writes. Build first, then gate:',
    '  npm run build && npx bbe-gate'
  ]);
}

// kit.local is the kit FILE itself, the one place ONE-SYSTEM-LAW.md says the brand's raw
// hex is allowed to live. It is exempt from the hex ratchet automatically, the moment a
// repo names it here — a consumer no longer types "kit" (or the kit's own path) into
// "exclude" by hand to get the same effect. Every one of the seven 2026-09-13 kit mints
// needed that manual exclude before this; this is the fix so the next one does not.
const kitLocalExclude = (config.kit && config.kit.local) ? [config.kit.local.replace(/^\.?\//, '')] : [];
// buildDir is build OUTPUT: it carries the pack's colors the engine wrote back into CSS.
// Kept out of the hex ratchet so a buildDir the defaults do not already skip ("public",
// "out") never counts the pack against itself. The kit and head scans read it on purpose.
const buildDirExclude = buildDir ? [buildDir] : [];
const exclude = [...DEFAULT_EXCLUDE, ...EXTRA_EXCLUDE, ...(config.exclude || []), ...kitLocalExclude, ...buildDirExclude];

// ---------------------------------------------------------------- the scan
// Positional call, the same exported function vault/core/engine/estate-status.mjs
// calls in its object form. One scanner, so the CI number and the nightly number
// cannot be produced by two different pieces of code.
const scan = scanRepo(repoRoot, packPath, { exclude });

if (scan.error) die(scan.error);
if (scan.scanned === 0) {
  die('ZERO files scanned. This is a blind gate, not a clean one — check "exclude".');
}

const rose = scan.brand.length > config.baseline;
const fell = scan.brand.length < config.baseline;

// ---------------------------------------------------------------- the kit scan
// No ratchet here. brand-drift's baseline exists because a repo migrating onto
// the gate needs a runway to zero; a kit violation has no such runway — it is a
// surface defining its own button, its own font, its own primary colour, which
// is the exact drift ONE-SYSTEM-LAW.md exists to end. Any hit fails.
const kitResult = config.kit ? scanKit(repoRoot, config.kit, { exclude: config.exclude || [], buildDir }) : null;
const kitFailed = !!(kitResult && kitResult.hits.length > 0);
// A kit check that read zero pages only ran its reserved-token half. That warns and
// does not fail: v1.3.1 repos already run this check, and an engine site among them
// would go red on upgrade for a gap that is not new. "buildDir" clears it either way.
const kitBlind = !!(kitResult && kitResult.pagesChecked === 0);

// ---------------------------------------------------------------- the head scan
// Same no-ratchet posture as the kit scan: this proves every page carries the
// ONE favicon and a default share image, and a partial rollout is exactly the
// bug it exists to catch. Independently opt-in per key (kit.favicon,
// kit.ogImage), so a brand can wire in one before the other, and a repo with
// neither key set behaves exactly as it did before this check existed.
const headResult = config.kit ? scanHead(repoRoot, config.kit, { exclude: config.exclude || [], buildDir }) : null;
const headFailed = !!(headResult && headResult.hits.length > 0);
// The head check is new in 1.4.0, so no repo is live on it yet and a blind run can
// fail from day one. A check that reads zero pages and passes is not a check. Exit 2,
// the gate's "could not run" code, because nothing was actually measured.
const headBlind = !!(headResult && (headResult.faviconChecked || headResult.ogImageChecked) && headResult.filesChecked === 0);
const exitCode = (rose || kitFailed || headFailed) ? 1 : (headBlind ? 2 : 0);

if (JSON_OUT) {
  console.log(JSON.stringify({
    ok: exitCode === 0,
    tool: `@andrew22lane/bbe ${PKG.version}`,
    repo: scan.repo,
    config: configSource,
    pack: config.pack,
    buildDir,
    exclude,
    scanned: scan.scanned,
    files: scan.files,
    packColours: scan.packColours,
    brand: scan.brand.length,
    brandUnique: scan.brandUnique,
    baseline: config.baseline,
    unregistered: scan.unregistered.length,
    unregisteredUnique: scan.unregisteredUnique,
    hits: scan.brand,
    kit: kitResult ? {
      checked: true,
      filesChecked: kitResult.filesChecked,
      pagesChecked: kitResult.pagesChecked,
      builtPagesChecked: kitResult.builtPagesChecked,
      blind: kitBlind,
      hits: kitResult.hits.length,
      violations: kitResult.hits
    } : { checked: false },
    head: headResult ? {
      checked: true,
      faviconChecked: headResult.faviconChecked,
      ogImageChecked: headResult.ogImageChecked,
      filesChecked: headResult.filesChecked,
      builtFilesChecked: headResult.builtFilesChecked,
      blind: headBlind,
      hits: headResult.hits.length,
      violations: headResult.hits
    } : { checked: false }
  }, null, 2));
  process.exit(exitCode);
}

say(`brand gate — pack ${config.pack}  (@andrew22lane/bbe ${PKG.version} bbe-gate)`);
say(`  repo         ${scan.repo}`);
say(`  config       ${path.relative(repoRoot, configSource) || configSource}`);
say(`  scanned      ${scan.scanned} of ${scan.files} files`);
say(`  pack colours ${scan.packColours}`);
if (config.exclude && config.exclude.length) say(`  also excluded ${config.exclude.join(', ')}`);
if (kitLocalExclude.length) say(`  kit file exempt from the hex ratchet: ${kitLocalExclude.join(', ')}`);
if (buildDir) say(`  built output ${buildDir}/  (kit links and head tags are read here too)`);
say(`  BRAND hits: ${scan.brand.length}  (baseline: ${config.baseline})`);
for (const b of scan.brand.slice(0, 60)) {
  say(`    ${b.file}:${b.line}  ${b.literal}  -> ${b.packName}`);
}
if (scan.brand.length > 60) say(`    ...and ${scan.brand.length - 60} more`);
say(`  UNREGISTERED (warn only): ${scan.unregistered.length} hits, ${scan.unregisteredUnique} unique`);

// ---------------------------------------------------------------- the kit report
if (kitResult) {
  say('');
  const builtKit = buildDir ? `, ${kitResult.builtPagesChecked} of them in ${buildDir}/` : '';
  say(`  kit check    ${config.kit.url || config.kit.local}  (${kitResult.filesChecked} files checked, ${kitResult.pagesChecked} pages${builtKit})`);
  for (const h of kitResult.hits) say(`  KIT: ${h.file}:${h.line} ${h.reason}`);
  say(`  KIT hits: ${kitResult.hits.length}`);
  if (kitBlind) {
    say(`  KIT WARNING: the link-first half read 0 pages, so only the reserved-token half ran.`);
    say(buildDir
      ? `               Nothing in ${buildDir}/ or the source is a page. Did the build write where "buildDir" says?`
      : `               A site whose pages come from a build script has none in its source. Add "buildDir": "dist" to ${CONFIG_NAME}.`);
  }
} else {
  // No "kit" object at all: a repo whose brand has none yet keeps passing, not going
  // dark silently. One line, machine-checkable, never a FAIL.
  say('');
  say(`  kit check    skipped — no "kit" in ${CONFIG_NAME} (see vault/core/ONE-SYSTEM-LAW.md)`);
}

// ---------------------------------------------------------------- the head report
say('');
if (config.kit && (config.kit.favicon || config.kit.ogImage)) {
  const parts = [];
  if (config.kit.favicon) parts.push(`favicon ${config.kit.favicon}`);
  if (config.kit.ogImage) parts.push('og:image');
  const builtHead = buildDir ? `, ${headResult.builtFilesChecked} of them in ${buildDir}/` : '';
  say(`  head check   ${parts.join(' · ')}  (${headResult.filesChecked} files checked${builtHead})`);
  for (const h of headResult.hits) say(`  HEAD: ${h.file}:${h.line} ${h.reason}`);
  say(`  HEAD hits: ${headResult.hits.length}`);
  if (!config.kit.favicon) say(`  head check   favicon skipped — no "kit.favicon" in ${CONFIG_NAME}`);
  if (!config.kit.ogImage) say(`  head check   og:image skipped — no "kit.ogImage" in ${CONFIG_NAME}`);
} else {
  // Same posture as the "no kit at all" skip above: never a FAIL, never silent.
  say(`  head check   skipped — no "kit.favicon" or "kit.ogImage" in ${CONFIG_NAME} (see vault/core/ONE-SYSTEM-LAW.md)`);
}

// ---------------------------------------------------------------- --write-baseline
if (has('--write-baseline')) {
  if (configSource !== configPath) {
    console.error('');
    console.error(`FAIL: --write-baseline writes ${CONFIG_NAME}, and this repo is still on ${LEGACY_BASELINE}.`);
    console.error('Migrate first: docs/MIGRATE-GATE.md in andrew22lane/bbe.');
    process.exit(2);
  }
  if (rose) {
    console.error('');
    console.error(`FAIL: refusing to RAISE the baseline from ${config.baseline} to ${scan.brand.length}.`);
    console.error('The ratchet only goes down. A count that rose means a brand fact got typed');
    console.error('into code — fix that, or edit bbe.config.json by hand and say why in the PR.');
    process.exit(1);
  }
  if (!fell) {
    console.log('');
    console.log(`baseline already ${config.baseline}; nothing to write.`);
    process.exit(0);
  }
  const updated = { ...config, baseline: scan.brand.length };
  writeFileSync(configPath, JSON.stringify(updated, null, 2) + '\n');
  console.log('');
  console.log(`baseline lowered ${config.baseline} -> ${scan.brand.length} in ${CONFIG_NAME}. Commit it in this PR.`);
  process.exit(0);
}

if (kitFailed) {
  console.log('');
  console.log(`FAIL: ${kitResult.hits.length} KIT hit(s). Every surface links the kit first and defines none of its own reserved tokens. See vault/core/ONE-SYSTEM-LAW.md.`);
}

if (headFailed) {
  console.log('');
  console.log(`FAIL: ${headResult.hits.length} HEAD hit(s). Every page carries the ONE favicon and a share image. See vault/core/ONE-SYSTEM-LAW.md.`);
}

if (rose) {
  console.log('');
  console.log(`FAIL: BRAND count rose from ${config.baseline} to ${scan.brand.length}.`);
  console.log(`The baseline ratchets DOWN only — never raise "baseline" in ${CONFIG_NAME} by hand.`);
}

if (headBlind) {
  console.log('');
  console.log('FAIL: the head check is set up and read ZERO pages. A check that reads nothing and passes is not a check.');
  console.log(buildDir
    ? `Nothing in ${buildDir}/ or the source is a page. Did the build write where "buildDir" says?`
    : `A site whose pages come from a build script has none in its source. Add "buildDir": "dist" to ${CONFIG_NAME}, and build before the gate.`);
}

if (exitCode !== 0) process.exit(exitCode);

if (fell) {
  say('');
  say(`NOTE: BRAND count fell from ${config.baseline} to ${scan.brand.length}.`);
  say('Lock it in with `npx bbe-gate --write-baseline` and commit the change in this PR.');
}

say('PASS');
process.exit(0);
